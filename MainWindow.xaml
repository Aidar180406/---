<Window x:Class="HozMarketWareHouse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HozMarketWareHouse"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="#F3F3F3">
        <StackPanel Margin="183,106,165,42">
            <StackPanel>
                <Image Source="/Images/Снимок экрана 2026-09-08 080524.png" Width="332" Margin="10"/>
            </StackPanel>
            <StackPanel>
                <TextBlock>Email для кладовщика</TextBlock>
                <TextBox x:Name="TLogin" Padding="5"></TextBox>
                <TextBlock>Пароль</TextBlock>
                <PasswordBox  x:Name="Tpassword" Padding="5" PasswordChar="*"></PasswordBox>
                <StackPanel Height="53" Margin="20">
                    <Button Width="204" Height="42" FontSize="20" FontWeight="Bold" Background="#FF8400" Foreground="White" Click="Button_Click">Войти</Button>
                </StackPanel>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</Window>
