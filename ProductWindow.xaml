<Window x:Class="HozMarketWareHouse.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HozMarketWareHouse"
        mc:Ignorable="d"
        Title="ProductWindow" Height="450" Width="800">
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="41*"/>
            <RowDefinition Height="25*"/>
            <RowDefinition Height="151*"/>
        </Grid.RowDefinitions>
        <StackPanel Background="#F3F3F3" Margin="0,0,0,3" Orientation="Horizontal">
            <Image Source="/Images/Снимок экрана 2026-09-08 080524.png" Width="215" Height="76" HorizontalAlignment="Left"/>
            <Border Width="435"></Border>
            <Button Background="Red" Height="33" Width="124" FontWeight="Bold" Foreground="White" Click="Button_Click">Выход</Button>
        </StackPanel>
        <StackPanel Background="#F3F3F3" Margin="0,82,0,2" Grid.RowSpan="2" Orientation="Horizontal">
            <ComboBox x:Name="CB_Categories" Width="150" Height="19" Margin="10" BorderThickness="0.5" BorderBrush="Black" SelectionChanged="ComboBox_SelectionChanged"/>
            <ComboBox x:Name="CB_Sort" Width="150" Height="19"  Margin="10" BorderThickness="0.5" BorderBrush="Black" SelectionChanged="ComboBox_SelectionChanged_1">
                <ComboBoxItem>---</ComboBoxItem>
                <ComboBoxItem>По возрастанию (Цена)</ComboBoxItem>
                <ComboBoxItem>По убыванию (Цена)</ComboBoxItem>
                <ComboBoxItem>По возрастанию (Остатки)</ComboBoxItem>
                <ComboBoxItem>По убыванию (Остатки)</ComboBoxItem>
            </ComboBox>
            <TextBox x:Name="TB_Search" Margin="10" Width="315" Background="#F3F3F3" BorderThickness="0.5" BorderBrush="Black" TextChanged="TextBox_TextChanged"></TextBox>
            <Button Width="94" Height="26" Background="#FF8400" FontWeight="Bold" Foreground="White" BorderThickness="0.5" BorderBrush="Black" Click="Button_Click_1">Новый</Button>
        </StackPanel>
        <ScrollViewer Margin="0,3,0,0" Grid.Row="2" Background="#F3F3F3">
            <StackPanel>
                <ItemsControl x:Name="icProducts">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:ItemProduct></local:ItemProduct>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

    </Grid>
</Window>
